# Database
POSTGRES_DB=tokyo_apartments
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# API
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@postgres:5432/tokyo_apartments

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Scraping config
SCRAPE_CONCURRENCY=2          # parallel browser instances
SCRAPE_PAGE_TIMEOUT=30000     # ms before giving up on a page
SCRAPE_RESULT_TTL=21600       # seconds to cache results (6h)

# Optional: Firecrawl (add later)
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx

# Optional: Proxy (add later for anti-bot bypass)
# PROXY_URL=http://user:pass@proxy-host:port
